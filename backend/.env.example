# Copy this file to .env and fill in real values. Never commit .env itself.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:      mongodb://127.0.0.1:27017/student_management
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/student_management
MONGODB_URI=mongodb://127.0.0.1:27017/student_management

# CORS
CORS_ALLOW_ORIGIN=http://localhost:5173

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Uploads (profile images stored locally under /uploads; swap for S3/Cloudinary in production)
UPLOAD_DIR=uploads
